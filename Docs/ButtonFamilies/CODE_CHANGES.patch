+#!/usr/bin/env python3
+"""Merge this release into a NEW copy of a compatible RelayBar source tree.
+
+Never modifies the input tree, installs an app, runs copied code, or resolves a
+conflict by dropping a local change. Text merge uses system diff3, not git state.
+Unrelated feature engine edits remain byte-identical in the copy. A clean merge
+is not an SDK build or semantic compatibility proof; review and test the result.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import plistlib
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from typing import Dict, Tuple
+
+PACKAGE = Path(__file__).resolve().parents[1]
+EXCLUDED = {'.git', '.build', 'build', 'BuildLogs', '__pycache__', '.DS_Store'}
+REQUIRED = ['Sources/Mac/AppMain.swift', 'Sources/Core/PinnedChats.swift',
+            'Sources/Mac/PinnedChatsMac.swift', 'Sources/Mac/PinnedChatsAX.swift',
+            'Sources/Core/ContextStack.swift', 'Sources/Mac/ContextStackMac.swift',
+            'Sources/Core/NativeMenus.swift', 'Sources/Mac/NativeMenuController.swift',
+            'Sources/Mac/NativeAXSource.swift', 'Sources/Mac/Components.swift',
+            'Sources/Core/Models.swift', 'Package.swift', 'Resources/Info.plist', 'Scripts/build.sh']
+
+class MergeError(Exception):
+    pass
+
+def sha(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+def version(value: str) -> Tuple[int, int, int]:
+    if not re.fullmatch(r'\d+\.\d+\.\d+', value):
+        raise MergeError('Unrecognized version; refusing an automatic merge: ' + value)
+    return tuple(map(int, value.split('.')))  # type: ignore[return-value]
+
+def safe_relative(value: str) -> Path:
+    p = Path(value)
+    if p.is_absolute() or '..' in p.parts or not p.parts:
+        raise MergeError('Unsafe path in release manifest: ' + value)
+    return p
+
+def plain_root(path: Path, must_exist: bool = True) -> Path:
+    absolute = Path(os.path.abspath(path.expanduser()))
+    for part in [absolute, *absolute.parents]:
+        if part.is_symlink():
+            raise MergeError('Symlinked source/destination roots are not supported: ' + str(part))
+    if must_exist and not absolute.is_dir():
+        raise MergeError('Choose an extracted SOURCE folder, not a ZIP or installed .app: ' + str(absolute))
+    return absolute
+
+def inventory(root: Path) -> Dict[str, dict]:
+    result: Dict[str, dict] = {}
+    for directory, dirs, files in os.walk(root, followlinks=False):
+        here = Path(directory)
+        dirs[:] = sorted(d for d in dirs if d not in EXCLUDED)
+        for d in dirs:
+            if (here/d).is_symlink():
+                raise MergeError('Symlinked source directories are not supported: ' + str(here/d))
+        for name in sorted(files):
+            if name in EXCLUDED:
+                continue
+            p = here/name
+            if p.is_symlink() or not p.is_file():
+                raise MergeError('Only regular source files can be copied: ' + str(p))
+            if p.stat().st_size > 100_000_000 or len(result) >= 10000:
+                raise MergeError('Unexpectedly large source tree; review it manually.')
+            data = p.read_bytes()
+            result[str(p.relative_to(root))] = {'sha256': sha(data), 'mode': p.stat().st_mode & 0o777}
+    return result
+
+def three_way(local: bytes, base: bytes, proposed: bytes, name: str) -> bytes:
+    if local == proposed:
+        return local
+    if local == base:
+        return proposed
+    if proposed == base:
+        return local
+    if any(b'\0' in b for b in (local, base, proposed)):
+        raise MergeError('Binary merge conflict: ' + name)
+    tool = shutil.which('diff3')
+    if not tool:
+        raise MergeError('System diff3 is required to preserve edited files. No merge was performed.')
+    with tempfile.TemporaryDirectory(prefix='relaybar-merge-') as tmp:
+        paths = [Path(tmp)/part for part in ('current', 'base', 'families')]
+        for p, b in zip(paths, (local, base, proposed)):
+            p.write_bytes(b)
+        run = subprocess.run([tool, '-m', *map(str, paths)], capture_output=True, timeout=30)
+        if run.returncode != 0:
+            raise MergeError('Overlapping edits in ' + name + '. No output copy was created; original files are unchanged. Reconcile this file manually.')
+        return run.stdout
+
+def merge(source: Path, destination: Path, dry_run: bool = False) -> dict:
+    source, destination = plain_root(source), plain_root(destination, False)
+    if source.suffix == '.app':
+        raise MergeError('This tool needs editable source, not the installed RelayBar.app.')
+    if destination.exists():
+        raise MergeError('Destination already exists. Choose a NEW folder: ' + str(destination))
+    if source == destination or source in destination.parents or destination in source.parents:
+        raise MergeError('The output must be a separate sibling folder, not inside or above your source.')
+    if not destination.parent.is_dir():
+        raise MergeError('The output parent folder must already exist.')
+    before = inventory(source)
+    missing = [name for name in REQUIRED if name not in before]
+    if missing:
+        raise MergeError('This is not the complete 0.6+ combined source (Pins + Stack + Native Sheets). Missing: ' + ', '.join(missing))
+    info = plistlib.loads((source/'Resources/Info.plist').read_bytes())
+    if info.get('CFBundleIdentifier') != 'local.relaybar':
+        raise MergeError('Refusing a source tree that does not identify as local.relaybar.')
+    v = version(str(info.get('CFBundleShortVersionString', '')))
+    if v < (0, 6, 0) or v > (0, 7, 0):
+        raise MergeError('This patch accepts 0.6.x or 0.7.0 combined source only; refusing a downgrade or unrelated branch.')
+    manifest = json.loads((PACKAGE/'MergeSupport/manifest.json').read_text())
+    replacements: Dict[str, bytes] = {}
+    modes: Dict[str, int] = {}
+    decisions = []
+    for item in manifest['files']:
+        name = item['path']; relative = safe_relative(name)
+        proposal_path = PACKAGE/relative
+        proposed = proposal_path.read_bytes()
+        if sha(proposed) != item['proposed_sha256']:
+            raise MergeError('Release payload changed after its manifest was made: ' + name)
+        old = source/relative
+        local = old.read_bytes() if name in before else None
+        if old.exists() and not old.is_file():
+            raise MergeError('A folder occupies an output file path: ' + name)
+        if name == 'Resources/Info.plist':
+            # Preserve ALL extra local metadata; change only release identity.
+            patched = dict(info)
+            proposed_info = plistlib.loads(proposed)
+            patched['CFBundleShortVersionString'] = proposed_info['CFBundleShortVersionString']
+            try:
+                current_build = int(info['CFBundleVersion'])
+                proposed_build = int(proposed_info['CFBundleVersion'])
+            except (KeyError, ValueError, TypeError):
+                raise MergeError('Non-numeric build number; refusing to guess a replacement.')
+            patched['CFBundleVersion'] = str(max(current_build + (v < (0, 7, 0)), proposed_build))
+            result = local if patched == info else plistlib.dumps(patched, sort_keys=False)
+        elif item.get('base_sha256') is not None:
+            if local is None:
+                raise MergeError('A locally removed file would be reintroduced: ' + name)
+            base = (PACKAGE/'MergeSupport/base'/relative).read_bytes()
+            if sha(base) != item['base_sha256']:
+                raise MergeError('The supplied merge ancestor has changed: ' + name)
+            if sha(local) == item.get('accepted_upstream_sha256'):
+                result = proposed
+            else:
+                result = three_way(local, base, proposed, name)
+        else:
+            if local is not None and local != proposed:
+                raise MergeError('A local file conflicts with a NEW hierarchy file: ' + name)
+            result = proposed
+        assert result is not None
+        replacements[name] = result
+        modes[name] = before.get(name, {}).get('mode', item['mode']) | (item['mode'] & 0o111)
+        decisions.append({'path': name, 'status': 'unchanged' if result == local else ('added' if local is None else 'merged'), 'sha256': sha(result)})
+    if inventory(source) != before:
+        raise MergeError('Source changed during merge planning. Retry after saving/stopping edits.')
+    report = {'mode': 'dry-run' if dry_run else 'new-copy', 'source': str(source), 'destination': str(destination),
+              'ancestor': manifest['ancestor'], 'files': decisions,
+              'preserved_source_files': len(set(before) - set(replacements) - {'SHA256SUMS.txt'}),
+              'excluded': sorted(EXCLUDED), 'regenerated': ['SHA256SUMS.txt'],
+              'installed': False, 'mac_sdk_tested': False,
+              'note': 'Clean text merge only. Inspect changes, run Test.command and Button_Families_Test.command, then Install.command from the COPY.'}
+    if dry_run:
+        return report
+    temp = Path(tempfile.mkdtemp(prefix='.relaybar-families-', dir=destination.parent))
+    try:
+        for name, meta in before.items():
+            target = temp/safe_relative(name)
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(source/name, target)
+        for name, data in replacements.items():
+            target = temp/safe_relative(name)
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(data); target.chmod(modes[name])
+        # Every unrelated file is explicitly checked, not merely assumed preserved.
+        for name, meta in before.items():
+            if name not in replacements and sha((temp/name).read_bytes()) != meta['sha256']:
+                raise MergeError('Source changed while copying: ' + name)
+        if inventory(source) != before:
+            raise MergeError('Source changed while copying. No output was published; retry after edits stop.')
+        # Generate a NEW receipt and inventory only in the output copy.
+        report_name = 'BUTTON_FAMILIES_MERGE_REPORT.json'
+        if (temp/report_name).exists():
+            report_name = 'BUTTON_FAMILIES_MERGE_REPORT_0.7.json'
+        if (temp/report_name).exists():
+            raise MergeError('Existing merge receipts would be overwritten. Choose an unmerged source copy.')
+        (temp/report_name).write_text(json.dumps(report, indent=2) + '\n')
+        sums = []
+        for name, meta in inventory(temp).items():
+            if name != 'SHA256SUMS.txt':
+                sums.append(meta['sha256'] + '  ' + name)
+        (temp/'SHA256SUMS.txt').write_text('\n'.join(sorted(sums)) + '\n')
+        if destination.exists():
+            raise MergeError('Output appeared while working. Refusing to replace it.')
+        temp.rename(destination)
+    finally:
+        if temp.exists():
+            shutil.rmtree(temp)
+    return report
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('source', type=Path, help='Extracted, complete RelayBar 0.6.x source folder with your edits')
+    parser.add_argument('--output', type=Path, help='New sibling folder; must not exist')
+    parser.add_argument('--dry-run', action='store_true', help='Check compatibility and merges without creating an output copy')
+    args = parser.parse_args()
+    output = args.output or args.source.expanduser().absolute().with_name(args.source.name + '_Button_Families_Copy')
+    try:
+        result = merge(args.source, output, args.dry_run)
+        print(json.dumps(result, indent=2))
+        return 0
+    except (MergeError, OSError, ValueError, subprocess.SubprocessError) as error:
+        print('MERGE STOPPED: ' + str(error), file=sys.stderr)
+        return 2
+
+if __name__ == '__main__':
+    raise SystemExit(main())
